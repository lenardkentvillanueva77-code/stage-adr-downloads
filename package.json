{
  "name": "stage-post-adr-cue-recorder",
  "version": "1.1.0",
  "productName": "Post ADR Pro",
  "description": "Post ADR Pro — ADR spotting, cue management, and export",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "dist:win": "electron-builder --win",
    "dist:win:dir": "electron-builder --win --dir"
  },
  "keywords": [
    "adr",
    "post-production",
    "electron"
  ],
  "author": "Stage Post",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "pdfkit": "^0.18.0"
  },
  "build": {
    "appId": "com.stagepost.postadrpro",
    "productName": "Post ADR Pro",
    "artifactName": "Post ADR Pro Beta 1.1 ${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**/*",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "native/audio-engine/build-nmake2/PostAdrAudioEngine_artefacts/Debug/PostAdrAudioEngine.exe",
        "to": "native-audio/PostAdrAudioEngine.exe"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
      "node_modules/ffprobe-static/bin/win32/ia32/ffprobe.exe"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "publisherName": "Stage Post",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "Post ADR Pro Beta 1.1 Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Post ADR Pro Beta"
    },
    "portable": {
      "artifactName": "Post ADR Pro Beta 1.1 Portable ${version}.${ext}"
    }
  }
}
